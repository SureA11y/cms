{
  "name": "surea11y-cms",
  "private": true,
  "description": "SureA11y for CMS: the shared panel, the CMS pack and the CMS plugins",
  "workspaces": [
    "packages/pack-cms",
    "packages/panel"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "lint": "eslint .",
    "format": "prettier --write \"packages/*/src/**/*.js\" \"packages/*/tests/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" eslint.config.mjs",
    "format:check": "prettier --check \"packages/*/src/**/*.js\" \"packages/*/tests/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" eslint.config.mjs",
    "size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.56.0",
    "prettier": "^3.10.1"
  }
}
