  "scripts": {
    "build": "esbuild site.js --bundle --format=esm --define:process.env.NODE_ENV='\"production\"' --outfile=dist/site.js --log-level=warning",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@portabletext/to-html": "6.0.0",
    "@sanity/client": "8.14.1",
    "@sanity/visual-editing": "^6.2.0"
  }
}
